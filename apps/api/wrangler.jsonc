{
  "name": "mkurdi-docs",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mkurdi-ops-db",
      "database_id": "7639d654-0f88-4084-88f1-7b3aaa191f34"
    }
  ],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "mkurdi-ops-docs" }],
  "vectorize": [{ "binding": "VEC", "index_name": "mkurdi-ops-chunks" }],
  "ai": { "binding": "AI" },
  "workflows": [
    { "binding": "INGEST", "name": "mkurdi-ops-ingest", "class_name": "IngestWorkflow" }
  ],
  "vars": {
    "MODEL_EXTRACT": "google/gemini-2.5-flash",
    "MODEL_CHAT": "google/gemini-2.5-flash",
    // base64: PDF is sent inline to OpenRouter. Do NOT use "url" mode on a
    // workers.dev domain — Cloudflare edge bot protection can block
    // OpenRouter's fetcher (error 1010). Revisit only behind a custom domain.
    "PARSE_MODE": "base64",
    "PUBLIC_API_URL": "https://mkurdi-docs.abdalrhmankurdi12.workers.dev"
  }
}
